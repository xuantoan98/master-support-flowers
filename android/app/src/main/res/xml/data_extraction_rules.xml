<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: không sao lưu lên cloud và không chuyển dữ liệu sang máy mới.
     DB đơn/khách và ảnh QR ngân hàng chỉ nằm trên máy cho tới khi có backup riêng. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
